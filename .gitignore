# ==========================================================
# POSTGRESQL
# ==========================================================

# Dumps/backups locais
*.dump
*.backup

# Dumps SQL locais.
# ATENÇÃO:
# Caso o projeto possua scripts SQL que devam ser versionados,
# armazene-os explicitamente em database/scripts ou database/seeds.
*.sql

# Permitir SQL oficiais do projeto
!database/scripts/**/*.sql
!database/seeds/**/*.sql
!database/schemas/**/*.sql

# Arquivos físicos/data directory do PostgreSQL
pgdata/
postgres-data/
.postgres/


# ==========================================================
# BACKUPS
# ==========================================================

*.bak
*.old
*.orig
*.swp
*.swo

backup/
backups/


